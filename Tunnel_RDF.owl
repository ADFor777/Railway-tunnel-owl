  <rdf:Description rdf:about="http://tunnelmodeling.org/six-input-mining-composite#TB822_IV_ShallowTunnelProject_1">
    <rdf:type rdf:resource="http://tunnelmodeling.org/six-input-mining-composite#SupportScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rbr:schemeMeaning>整行候选参考参数；非最终设计；喷层为平均厚度；二衬仅拱墙，不代表仰拱</rbr:schemeMeaning>
    <rbr:shotcrete_arch_wall_cmMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</rbr:shotcrete_arch_wall_cmMax>
    <rbr:secondary_arch_wall_cmMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40</rbr:secondary_arch_wall_cmMax>
    <rbr:bolt_length_mMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</rbr:bolt_length_mMax>
    <rbr:bolt_spacing_mMax rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.2</rbr:bolt_spacing_mMax>
    <rbr:shotcrete_arch_wall_cmMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</rbr:shotcrete_arch_wall_cmMin>
    <rbr:bolt_length_mMin rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.5</rbr:bolt_length_mMin>
    <rbr:secondary_arch_wall_cmMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</rbr:secondary_arch_wall_cmMin>
    <rdfs:seeAlso>https://www.scribd.com/document/716889360/铁路隧道设计规范</rdfs:seeAlso>
    <rbr:schemeReference>TB 10003—2016 第8.2.2条条文说明，说明表8.2.2 pp.217—218</rbr:schemeReference>
    <rbr:bolt_spacing_mMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</rbr:bolt_spacing_mMin>
    <rbr:schemeConditions>{"grade": "IV", "rock_hardness": null, "burial": "ShallowTunnelProject", "excavation_span_m": {"lower_exclusive": 5, "upper_inclusive": 8.5}, "bolt_layout": "ArchAndWall", "applicability": "仅在规范说明表适用范围；特殊围岩等单独设计；未确认条件不得默认为真"}</rbr:schemeConditions>
  </rdf:Description>
