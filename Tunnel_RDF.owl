    <rdfs:label>CANDIDATE_TB822_III_HardRock_2</rdfs:label>
    <swrl:head>
      <rdf:Description rdf:nodeID="N63b30fa1670c474b8eb4232264e1d377">
        <rdf:first>
          <swrl:IndividualPropertyAtom rdf:nodeID="N50ad7dda8344492098a2f1a63eca199e">
            <swrl:argument2 rdf:resource="http://tunnelmodeling.org/six-input-mining-composite#TB822_III_HardRock_2"/>
            <swrl:propertyPredicate rdf:resource="http://tunnelmodeling.org/six-input-mining-composite#hasConditionalScheme"/>
            <swrl:argument1 rdf:resource="http://tunnelmodeling.org/six-input-mining-composite#t"/>
          </swrl:IndividualPropertyAtom>
        </rdf:first>
        <rdf:rest>
          <rdf:Description rdf:nodeID="N71d5ee2575f946648df432300753b631">
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
