    <rbr:steelRuleDefinition>{"id": "STEEL_LATTICE_LARGE", "clause": "7.4.1—7.4.2及表7.4.2", "if_conditions": ["浅埋土质隧道", "钢筋格栅支架", "按原表完整支护组合初选；复杂地质/周边环境还需计算", "实际开挖跨度满足该行范围"], "span_m": {"lower_exclusive": 6, "upper": 8, "upper_inclusive": false}, "conclusion": {"family": "RebarLatticeArch", "spacing_m": {"range": [0.5, 0.75], "selected_value": null}}, "meaning": "间距仅属于格栅方案，不能用于指定I18/I20a型钢；B=8m暂不处理正文/表格边界差异", "standard": "GB 50086—2015", "source_url": "https://www.bjhcgk.com/upload/files/20230113/ULGHUPAK-20230113100442.pdf", "local_source": "G:/02/TUNNEL/POST/5/修改/OWL规范引用核对/标准核对/GB50086-2015_text.pdf", "status": "附条件候选；适用性暂缓核查", "final_design_value": false, "selection_policy": "不选范围中值、上限或下限"}</rbr:steelRuleDefinition>
  </rdf:Description>
