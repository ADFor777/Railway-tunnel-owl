    <rbr:bolt_length_mMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</rbr:bolt_length_mMax>
  </rdf:Description>
  <rdf:Description rdf:about="http://tunnelmodeling.org/six-input-mining-composite#TB822_III_HardRock_3">
    <rdf:type rdf:resource="http://tunnelmodeling.org/six-input-mining-composite#SupportScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
